{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SprkNotes",
  "identifier": "dev.sprknotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "dragDropEnabled": false, "title": "SprkNotes", "width": 900, "height": 640 },
      {
        "label": "mini", "dragDropEnabled": false,
        "title": "SprkNotes mini controller",
        "url": "index.html#mini",
        "width": 200,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": { "active": false }
}
