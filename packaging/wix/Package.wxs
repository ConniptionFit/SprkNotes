<?xml version="1.0" encoding="UTF-8"?>
<!-- One MSI per architecture (MSI is single-arch by design). Built by scripts/release.ps1:
       wix build packaging/wix/Package.wxs -arch <x64|arm64> -d Version=<x.y.z> -d StageDir=<dir> -o <out.msi>
     Per-user by default; per-machine with ALLUSERS=1. Uninstall never touches transcripts. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SprkNotes" Manufacturer="SprkNotes" Version="$(Version)"
           UpgradeCode="E364340E-D3B6-4F2B-B0BB-F67B2274A9F7" Scope="perUserOrMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of SprkNotes is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SprkNotes" />
    </StandardDirectory>
    <Feature Id="Main" Title="SprkNotes" Level="1">
      <Files Include="$(StageDir)\**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="SprkNotes" Target="[INSTALLFOLDER]SprkNotes.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\SprkNotes" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
