<?xml version="1.0" encoding="UTF-8"?>
<!-- One MSI per architecture (MSI is single-arch by design). Built by scripts/release.ps1:
       wix build packaging/wix/Package.wxs -arch <x64|arm64> -d Version=<x.y.z[.n]> -d StageDir=<dir> -o <out.msi>
     Per-user by default; per-machine with ALLUSERS=1. Uninstall never touches transcripts.

     Install switches (all optional; see docs/deployment.md):
       UPDATE_CHANNEL=stable|beta|alpha     release channel
       UPDATE_REPO_URL=https://...          repository releases come from (Forgejo or GitHub)
       UPDATE_PROVIDER=forgejo|github       only when the address does not make it obvious
       UPDATE_MODE=off|notify|auto|force    how updates are applied
       UPDATE_PUBLIC_KEY="ssh-ed25519 ..."  key that may sign update manifests
       LOCK_UPDATES=1                       write these as admin policy (locked in Settings) instead of
                                            starting values the user may change. Real locking needs a
                                            per-machine install (HKLM); per-user writes HKCU.
       UPDATE_TASK=0                        per-machine only: do not create the scheduled update task
     Per-machine installs register the "SprkNotes\Update" task (SYSTEM, every 6 hours, no window) that
     runs SprkNotes.exe with the update switch. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="SprkNotes" Manufacturer="SprkNotes" Version="$(Version)"
           UpgradeCode="E364340E-D3B6-4F2B-B0BB-F67B2274A9F7" Scope="perUserOrMachine" Compressed="yes">
    <!-- Windows Installer ignores the fourth version field when ordering upgrades, and pre-releases
         only differ there; the updater decides what is newer, so same-version upgrades are allowed. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of SprkNotes is already installed."
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="UPDATE_CHANNEL" Secure="yes" />
    <Property Id="UPDATE_REPO_URL" Secure="yes" />
    <Property Id="UPDATE_PROVIDER" Secure="yes" />
    <Property Id="UPDATE_MODE" Secure="yes" />
    <Property Id="UPDATE_PUBLIC_KEY" Secure="yes" />
    <Property Id="LOCK_UPDATES" Secure="yes" />
    <Property Id="UPDATE_TASK" Secure="yes" />

    <!-- Upgrades keep what an earlier install wrote. The registry values below exist only while their
         install property is set, and an upgrade usually runs without them (the updater runs
         "msiexec /i new.msi /qn"), so Windows Installer would drop the admin policy, the lock and the
         channel with the old version. These searches read the old values back into the properties
         before costing, unless the caller passed new ones. PM/PU = policy (machine/user),
         DM/DU = starting default. -->
    <Property Id="OLD_PM_CHANNEL"><RegistrySearch Id="RsPMCHANNEL" Root="HKLM" Key="Software\Policies\SprkNotes" Name="UpdateChannel" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_PM_REPOURL"><RegistrySearch Id="RsPMREPOURL" Root="HKLM" Key="Software\Policies\SprkNotes" Name="UpdateRepoUrl" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_PM_PROVIDER"><RegistrySearch Id="RsPMPROVIDER" Root="HKLM" Key="Software\Policies\SprkNotes" Name="UpdateProvider" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_PM_MODE"><RegistrySearch Id="RsPMMODE" Root="HKLM" Key="Software\Policies\SprkNotes" Name="UpdateMode" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_PM_KEYS"><RegistrySearch Id="RsPMKEYS" Root="HKLM" Key="Software\Policies\SprkNotes" Name="UpdatePublicKeys" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_DM_CHANNEL"><RegistrySearch Id="RsDMCHANNEL" Root="HKLM" Key="Software\SprkNotes\Defaults" Name="UpdateChannel" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_DM_REPOURL"><RegistrySearch Id="RsDMREPOURL" Root="HKLM" Key="Software\SprkNotes\Defaults" Name="UpdateRepoUrl" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_DM_PROVIDER"><RegistrySearch Id="RsDMPROVIDER" Root="HKLM" Key="Software\SprkNotes\Defaults" Name="UpdateProvider" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_DM_MODE"><RegistrySearch Id="RsDMMODE" Root="HKLM" Key="Software\SprkNotes\Defaults" Name="UpdateMode" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_DM_KEYS"><RegistrySearch Id="RsDMKEYS" Root="HKLM" Key="Software\SprkNotes\Defaults" Name="UpdatePublicKeys" Type="raw" Bitness="always64" /></Property>
    <Property Id="OLD_PU_CHANNEL"><RegistrySearch Id="RsPUCHANNEL" Root="HKCU" Key="Software\Policies\SprkNotes" Name="UpdateChannel" Type="raw" /></Property>
    <Property Id="OLD_PU_REPOURL"><RegistrySearch Id="RsPUREPOURL" Root="HKCU" Key="Software\Policies\SprkNotes" Name="UpdateRepoUrl" Type="raw" /></Property>
    <Property Id="OLD_PU_PROVIDER"><RegistrySearch Id="RsPUPROVIDER" Root="HKCU" Key="Software\Policies\SprkNotes" Name="UpdateProvider" Type="raw" /></Property>
    <Property Id="OLD_PU_MODE"><RegistrySearch Id="RsPUMODE" Root="HKCU" Key="Software\Policies\SprkNotes" Name="UpdateMode" Type="raw" /></Property>
    <Property Id="OLD_PU_KEYS"><RegistrySearch Id="RsPUKEYS" Root="HKCU" Key="Software\Policies\SprkNotes" Name="UpdatePublicKeys" Type="raw" /></Property>
    <Property Id="OLD_DU_CHANNEL"><RegistrySearch Id="RsDUCHANNEL" Root="HKCU" Key="Software\SprkNotes\Defaults" Name="UpdateChannel" Type="raw" /></Property>
    <Property Id="OLD_DU_REPOURL"><RegistrySearch Id="RsDUREPOURL" Root="HKCU" Key="Software\SprkNotes\Defaults" Name="UpdateRepoUrl" Type="raw" /></Property>
    <Property Id="OLD_DU_PROVIDER"><RegistrySearch Id="RsDUPROVIDER" Root="HKCU" Key="Software\SprkNotes\Defaults" Name="UpdateProvider" Type="raw" /></Property>
    <Property Id="OLD_DU_MODE"><RegistrySearch Id="RsDUMODE" Root="HKCU" Key="Software\SprkNotes\Defaults" Name="UpdateMode" Type="raw" /></Property>
    <Property Id="OLD_DU_KEYS"><RegistrySearch Id="RsDUKEYS" Root="HKCU" Key="Software\SprkNotes\Defaults" Name="UpdatePublicKeys" Type="raw" /></Property>
    <SetProperty Action="Restore_UPDATE_CHANNEL_PM" Id="UPDATE_CHANNEL" Value="[OLD_PM_CHANNEL]" After="AppSearch" Condition="NOT UPDATE_CHANNEL AND OLD_PM_CHANNEL AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_CHANNEL_DM" Id="UPDATE_CHANNEL" Value="[OLD_DM_CHANNEL]" After="AppSearch" Condition="NOT UPDATE_CHANNEL AND OLD_DM_CHANNEL AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_CHANNEL_PU" Id="UPDATE_CHANNEL" Value="[OLD_PU_CHANNEL]" After="AppSearch" Condition="NOT UPDATE_CHANNEL AND OLD_PU_CHANNEL AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_CHANNEL_DU" Id="UPDATE_CHANNEL" Value="[OLD_DU_CHANNEL]" After="AppSearch" Condition="NOT UPDATE_CHANNEL AND OLD_DU_CHANNEL AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_REPO_URL_PM" Id="UPDATE_REPO_URL" Value="[OLD_PM_REPOURL]" After="AppSearch" Condition="NOT UPDATE_REPO_URL AND OLD_PM_REPOURL AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_REPO_URL_DM" Id="UPDATE_REPO_URL" Value="[OLD_DM_REPOURL]" After="AppSearch" Condition="NOT UPDATE_REPO_URL AND OLD_DM_REPOURL AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_REPO_URL_PU" Id="UPDATE_REPO_URL" Value="[OLD_PU_REPOURL]" After="AppSearch" Condition="NOT UPDATE_REPO_URL AND OLD_PU_REPOURL AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_REPO_URL_DU" Id="UPDATE_REPO_URL" Value="[OLD_DU_REPOURL]" After="AppSearch" Condition="NOT UPDATE_REPO_URL AND OLD_DU_REPOURL AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PROVIDER_PM" Id="UPDATE_PROVIDER" Value="[OLD_PM_PROVIDER]" After="AppSearch" Condition="NOT UPDATE_PROVIDER AND OLD_PM_PROVIDER AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PROVIDER_DM" Id="UPDATE_PROVIDER" Value="[OLD_DM_PROVIDER]" After="AppSearch" Condition="NOT UPDATE_PROVIDER AND OLD_DM_PROVIDER AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PROVIDER_PU" Id="UPDATE_PROVIDER" Value="[OLD_PU_PROVIDER]" After="AppSearch" Condition="NOT UPDATE_PROVIDER AND OLD_PU_PROVIDER AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PROVIDER_DU" Id="UPDATE_PROVIDER" Value="[OLD_DU_PROVIDER]" After="AppSearch" Condition="NOT UPDATE_PROVIDER AND OLD_DU_PROVIDER AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_MODE_PM" Id="UPDATE_MODE" Value="[OLD_PM_MODE]" After="AppSearch" Condition="NOT UPDATE_MODE AND OLD_PM_MODE AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_MODE_DM" Id="UPDATE_MODE" Value="[OLD_DM_MODE]" After="AppSearch" Condition="NOT UPDATE_MODE AND OLD_DM_MODE AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_MODE_PU" Id="UPDATE_MODE" Value="[OLD_PU_MODE]" After="AppSearch" Condition="NOT UPDATE_MODE AND OLD_PU_MODE AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_MODE_DU" Id="UPDATE_MODE" Value="[OLD_DU_MODE]" After="AppSearch" Condition="NOT UPDATE_MODE AND OLD_DU_MODE AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PUBLIC_KEY_PM" Id="UPDATE_PUBLIC_KEY" Value="[OLD_PM_KEYS]" After="AppSearch" Condition="NOT UPDATE_PUBLIC_KEY AND OLD_PM_KEYS AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PUBLIC_KEY_DM" Id="UPDATE_PUBLIC_KEY" Value="[OLD_DM_KEYS]" After="AppSearch" Condition="NOT UPDATE_PUBLIC_KEY AND OLD_DM_KEYS AND ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PUBLIC_KEY_PU" Id="UPDATE_PUBLIC_KEY" Value="[OLD_PU_KEYS]" After="AppSearch" Condition="NOT UPDATE_PUBLIC_KEY AND OLD_PU_KEYS AND NOT ALLUSERS=1" />
    <SetProperty Action="Restore_UPDATE_PUBLIC_KEY_DU" Id="UPDATE_PUBLIC_KEY" Value="[OLD_DU_KEYS]" After="AppSearch" Condition="NOT UPDATE_PUBLIC_KEY AND OLD_DU_KEYS AND NOT ALLUSERS=1" />
    <SetProperty Action="RestoreLockM" Id="LOCK_UPDATES" Value="1" After="AppSearch" Condition="NOT LOCK_UPDATES AND ALLUSERS=1 AND (OLD_PM_CHANNEL OR OLD_PM_REPOURL OR OLD_PM_PROVIDER OR OLD_PM_MODE OR OLD_PM_KEYS)" />
    <SetProperty Action="RestoreLockU" Id="LOCK_UPDATES" Value="1" After="AppSearch" Condition="NOT LOCK_UPDATES AND NOT ALLUSERS=1 AND (OLD_PU_CHANNEL OR OLD_PU_REPOURL OR OLD_PU_PROVIDER OR OLD_PU_MODE OR OLD_PU_KEYS)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SprkNotes" />
    </StandardDirectory>
    <Feature Id="Main" Title="SprkNotes" Level="1">
      <Files Include="$(StageDir)\**" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RegDefMachineMode" />
      <ComponentRef Id="RegDefUpdateChannel" />
      <ComponentRef Id="RegPolUpdateChannel" />
      <ComponentRef Id="RegDefUpdateRepoUrl" />
      <ComponentRef Id="RegPolUpdateRepoUrl" />
      <ComponentRef Id="RegDefUpdateProvider" />
      <ComponentRef Id="RegPolUpdateProvider" />
      <ComponentRef Id="RegDefUpdateMode" />
      <ComponentRef Id="RegPolUpdateMode" />
      <ComponentRef Id="RegDefUpdatePublicKeys" />
      <ComponentRef Id="RegPolUpdatePublicKeys" />
    </Feature>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="SprkNotes" Target="[INSTALLFOLDER]SprkNotes.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\SprkNotes" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Installer-set values. "Defaults" never lock a setting; "Policies" do. -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- A per-machine install is updated unattended by the task below, so it starts in auto mode. -->
      <Component Id="RegDefMachineMode" Guid="*" Condition="ALLUSERS=1 AND NOT UPDATE_MODE">
        <RegistryValue Root="HKLM" Key="Software\SprkNotes\Defaults" Name="UpdateMode" Type="string" Value="auto" KeyPath="yes" />
      </Component>
      <Component Id="RegDefUpdateChannel" Guid="*" Condition="UPDATE_CHANNEL AND NOT LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\SprkNotes\Defaults" Name="UpdateChannel" Type="string" Value="[UPDATE_CHANNEL]" KeyPath="yes" />
      </Component>
      <Component Id="RegPolUpdateChannel" Guid="*" Condition="UPDATE_CHANNEL AND LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\Policies\SprkNotes" Name="UpdateChannel" Type="string" Value="[UPDATE_CHANNEL]" KeyPath="yes" />
      </Component>
      <Component Id="RegDefUpdateRepoUrl" Guid="*" Condition="UPDATE_REPO_URL AND NOT LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\SprkNotes\Defaults" Name="UpdateRepoUrl" Type="string" Value="[UPDATE_REPO_URL]" KeyPath="yes" />
      </Component>
      <Component Id="RegPolUpdateRepoUrl" Guid="*" Condition="UPDATE_REPO_URL AND LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\Policies\SprkNotes" Name="UpdateRepoUrl" Type="string" Value="[UPDATE_REPO_URL]" KeyPath="yes" />
      </Component>
      <Component Id="RegDefUpdateProvider" Guid="*" Condition="UPDATE_PROVIDER AND NOT LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\SprkNotes\Defaults" Name="UpdateProvider" Type="string" Value="[UPDATE_PROVIDER]" KeyPath="yes" />
      </Component>
      <Component Id="RegPolUpdateProvider" Guid="*" Condition="UPDATE_PROVIDER AND LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\Policies\SprkNotes" Name="UpdateProvider" Type="string" Value="[UPDATE_PROVIDER]" KeyPath="yes" />
      </Component>
      <Component Id="RegDefUpdateMode" Guid="*" Condition="UPDATE_MODE AND NOT LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\SprkNotes\Defaults" Name="UpdateMode" Type="string" Value="[UPDATE_MODE]" KeyPath="yes" />
      </Component>
      <Component Id="RegPolUpdateMode" Guid="*" Condition="UPDATE_MODE AND LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\Policies\SprkNotes" Name="UpdateMode" Type="string" Value="[UPDATE_MODE]" KeyPath="yes" />
      </Component>
      <Component Id="RegDefUpdatePublicKeys" Guid="*" Condition="UPDATE_PUBLIC_KEY AND NOT LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\SprkNotes\Defaults" Name="UpdatePublicKeys" Type="string" Value="[UPDATE_PUBLIC_KEY]" KeyPath="yes" />
      </Component>
      <Component Id="RegPolUpdatePublicKeys" Guid="*" Condition="UPDATE_PUBLIC_KEY AND LOCK_UPDATES=&quot;1&quot;">
        <RegistryValue Root="HKMU" Key="Software\Policies\SprkNotes" Name="UpdatePublicKeys" Type="string" Value="[UPDATE_PUBLIC_KEY]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Per-machine only: a SYSTEM task that keeps the install current without a window or a prompt.
         It skips while SprkNotes is open and tries again at the next run. -->
    <CustomAction Id="CreateUpdateTask" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
      ExeCommand="schtasks.exe /Create /F /TN &quot;SprkNotes\Update&quot; /SC HOURLY /MO 6 /RU SYSTEM /RL HIGHEST /TR &quot;\&quot;[INSTALLFOLDER]SprkNotes.exe\&quot; --update&quot;" />
    <!-- schtasks /Create defaults stop a task on battery and skip missed runs. Loosen that so a laptop updates
         unattended too. Return="ignore": if this fails the task still exists with the defaults. -->
    <CustomAction Id="TuneUpdateTask" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$s = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -MultipleInstances IgnoreNew; Set-ScheduledTask -TaskPath '\SprkNotes\' -TaskName 'Update' -Settings $s&quot;" />
    <CustomAction Id="RemoveUpdateTask" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
      ExeCommand="schtasks.exe /Delete /F /TN &quot;SprkNotes\Update&quot;" />
    <InstallExecuteSequence>
      <Custom Action="CreateUpdateTask" Before="InstallFinalize" Condition="ALLUSERS=1 AND NOT (UPDATE_TASK=&quot;0&quot;) AND NOT REMOVE" />
      <Custom Action="TuneUpdateTask" After="CreateUpdateTask" Condition="ALLUSERS=1 AND NOT (UPDATE_TASK=&quot;0&quot;) AND NOT REMOVE" />
      <Custom Action="RemoveUpdateTask" After="InstallInitialize" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
